# SQLite connection string. Relative paths are resolved from the project root.
DATABASE_URL=sqlite:///./data/processed/forecasting.db

# Local data and model artifact directories
DATA_DIR=./data
MODEL_DIR=./artifacts

# Backend URL used by the Streamlit dashboard
API_BASE_URL=http://127.0.0.1:8000

# OpenRouter LLM (optional). The app runs without this key.
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=Agentic Demand Forecasting

LOG_LEVEL=INFO
FORECAST_HORIZON=7
SAMPLE_DATA_MODE=true

# Optional M5 ingest filters (ignored in sample-data mode)
M5_STORE_FILTER=
M5_MAX_ITEMS=50
